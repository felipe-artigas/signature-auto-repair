# Copiar como backend/.env y completar. Nunca subir el archivo .env al repositorio.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/signature.db

# Orígenes permitidos (separados por coma) y URL pública del sitio
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Token de un solo uso para crear la cuenta administrativa en /admin/setup.
# Vaciar una vez creada la cuenta.
ADMIN_SETUP_TOKEN=

# En desarrollo local sin HTTPS usar false. En producción debe ser true.
COOKIE_SECURE=false

# Inteligencia artificial: "mock" (modo de pruebas, sin consumo) u "openai".
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
AI_DAILY_REQUEST_BUDGET=1500
AI_DAILY_TOKEN_BUDGET=2000000
